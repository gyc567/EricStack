# Acceptance Pipeline Specification (APS) — EricStack Configuration
# Aligned with docs/APS_INTEGRATION.md v1.1 (7-stage pipeline).
#
# Source of truth: docs/APS_INTEGRATION.md
# This file is loaded by the APS runner. Use KEY=VALUE (no spaces around =).
# Lines starting with # are comments. Section dividers are # ===...===

# ============================================================
# 0. Tool Availability Gate (C2 fix — default OFF)
# ============================================================
# APS_TOOL_AVAILABLE: Set to true ONLY when gherkin-parser/dry-checker/mutator
# binaries are actually present in .loopx/acceptance-pipeline/bin/{bb,go}/.
# Default is false to prevent silent failure when tools are missing.
APS_TOOL_AVAILABLE=false

# ============================================================
# 1. Version & Tool Mode
# ============================================================
# Pinned to a specific APS release to prevent spec-evolution breakage.
# Override with: APS_VERSION=v1.3.0 bash install-acceptance-pipeline.sh
APS_VERSION=v1.2.0
APS_TOOL_MODE=babashka  # babashka | go | auto

# Checksum verification (.loopx/aps.checksums must contain SHA256)
APS_VERIFY_CHECKSUMS=true

# ============================================================
# 2. Directory Layout (overridable, but defaults match docs)
# ============================================================
APS_FEATURE_DIR=.loopx/acceptance-pipeline/features
APS_IR_DIR=.loopx/acceptance-pipeline/ir
APS_GENERATED_DIR=.loopx/acceptance-pipeline/generated
APS_REPORTS_DIR=.loopx/acceptance-pipeline/reports
APS_CACHE_DIR=.loopx/cache/aps
APS_HOOKS_FILE=.loopx/acceptance-pipeline/hooks.yaml

# ============================================================
# 3. Test Framework Adapter (3.3 — multiple frameworks)
# ============================================================
# Valid values: auto | junit5 | pytest | behave | jest | rspec | go | vitest | kotest
# auto = detect from project (look for pytest.ini, package.json, etc.)
APS_FRAMEWORK=auto

# ============================================================
# 4. Stage 0: Spec/Feature Lint
# ============================================================
APS_LINT_ENABLED=true
APS_LINT_MIN_SCENARIOS=1
APS_LINT_MAX_STEPS=15
APS_LINT_REQUIRE_BACKGROUND=true
APS_LINT_ALLOWED_TAGS=@smoke,@regression,@auth,@api,@ui,@integration,@slow,@quarantine

# ============================================================
# 5. Stage 2: DRY Check Thresholds (was C1 — now mandatory)
# ============================================================
# duplicate-in-scenario > 0  → block (exit 1)
APS_DRY_CHECK_THRESHOLD=0

# placeholder-variant > N     → block + 修复建议
APS_PLACEHOLDER_VARIANT_THRESHOLD=3

# near-duplicate similarity   → warn (exit 0 with TODO)
APS_NEAR_DUPLICATE_THRESHOLD=0.85

# ============================================================
# 6. Stage 3: Generation & Step Coverage
# ============================================================
# fail-fast if missing handlers > 0 (recommended)
APS_FAIL_ON_MISSING_HANDLERS=true

# warn on orphan handlers (registered but unused in IR)
APS_WARN_ON_ORPHAN_HANDLERS=true

# ============================================================
# 7. Stage 4: Run — Sandboxing (3.3.2)
# ============================================================
APS_SANDBOX=auto  # auto | strict | off
APS_SANDBOX_DETECT_SIDE_EFFECTS=true
APS_SANDBOX_REQUIRE_DISPOSE=true

# ============================================================
# 8. Stage 5: Mutation — Tiered Quality Gate (v1.1)
# ============================================================
# Replaces APS_MUTATION_SURVIVAL_RATE_MAX=5 (old single-threshold).
# Thresholds map to docs/APS_INTEGRATION.md §3.4.
APS_MUTATION_EXCELLENT_THRESHOLD=3     # < 3%  → excellent
APS_MUTATION_WARN_THRESHOLD=8          # 3-8%  → warn (with trend)
APS_MUTATION_TODO_THRESHOLD=15         # 8-15% → warn + improvement TODO
# > 15% → block merge (exit 2)
# > 30% → block + alert + mark P1 tech debt

# Whitelist file: @mutation-suppress annotated code blocks
APS_MUTATION_WHITELIST=.loopx/acceptance-pipeline/mutation-whitelist.txt

# Incremental cache
APS_MUTATION_INCREMENTAL=true
APS_MUTATION_TIMEOUT_SECONDS=300

# ============================================================
# 9. Incremental Cache (v1.1 — §3.1.4)
# ============================================================
# Cache key: hash(path + mtime + content_sha256)
# Default TTL 7 days, CI bypasses TTL.
APS_CACHE_ENABLED=true
APS_CACHE_TTL_DAYS=7
APS_CACHE_LRU_MAX_ENTRIES=1000

# ============================================================
# 10. Output & Progress
# ============================================================
APS_PROGRESS=auto       # auto | bar | json | plain | off
APS_VERBOSITY=normal    # quiet | normal | verbose | trace
APS_OUTPUT_FORMAT=junit # junit | json | tap (CI uses junit)

# ============================================================
# 11. Exit Codes (v1.1 — §3.1.3)
# ============================================================
# 0   — all stages passed
# 1   — parse/generate/run error (incl. DRY block, missing handler)
# 2   — mutation survival exceeds block threshold
# 3   — user interrupt (SIGINT)
# 4   — environment error (BB missing, version mismatch)
# 130 — SIGKILL

# ============================================================
# 12. Failure Diagnosis (Stage 6 — v1.1 §10)
# ============================================================
APS_DIAGNOSE_ON_FAILURE=true
APS_DIAGNOSE_FORMAT=markdown  # markdown | json
APS_DIAGNOSE_DIR=.loopx/acceptance-pipeline/reports/diagnose

# ============================================================
# 13. Plugin Hooks (v1.1 §3.1.5)
# ============================================================
APS_HOOKS_ENABLED=true
# Hooks are read from $APS_HOOKS_FILE if present.
# Example: before_parse: ["scripts/preprocess-feature.clj"]

# ============================================================
# 14. Custom Stages (v1.1 §12.3)
# ============================================================
APS_CUSTOM_STAGES_FILE=.loopx/acceptance-pipeline/custom-stages.yaml

# ============================================================
# 15. Legacy / Deprecated
# ============================================================
# APS_MUTATION_SURVIVAL_RATE_MAX is kept for backward compatibility.
# New code should use APS_MUTATION_TODO_THRESHOLD (=15).
# If both are set, the explicit *_THRESHOLD wins.
APS_MUTATION_SURVIVAL_RATE_MAX=15
